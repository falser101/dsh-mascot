{
  "name": "@falser101/mascot",
  "version": "0.1.0",
  "description": "Draggable animated floating companion for the DeepSeek Harness web GUI, with cat and dog breed skins that react to the current session",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/falser101/dsh-mascot.git"
  },
  "homepage": "https://github.com/falser101/dsh-mascot#readme",
  "bugs": {
    "url": "https://github.com/falser101/dsh-mascot/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mascot"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-invariants": ">=0.1.0-rc.5",
    "react": ">=18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-test-runtime": ">=0.1.0-rc.5",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "jsdom": "^25.0.0",
    "lightningcss": "^1.29.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.7.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
